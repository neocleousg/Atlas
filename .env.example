# Αντιγράψτε σε .env και συμπληρώστε. Το .env ΔΕΝ ανεβαίνει ποτέ στο αποθετήριο.
DJANGO_SECRET_KEY=αλλάξτε-με-τυχαία-συμβολοσειρά-τουλάχιστον-50-χαρακτήρων
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 1 όταν η εφαρμογή τρέχει πίσω από HTTPS (παραγωγή). 0 για δοκιμή σε http://localhost.
DJANGO_SECURE_SSL_REDIRECT=0

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=αλλάξτε-με-ισχυρό-κωδικό
POSTGRES_HOST=db
POSTGRES_PORT=5432
